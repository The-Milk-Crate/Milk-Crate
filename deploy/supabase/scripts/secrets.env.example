# Edge Function secrets for scripts/stand-up.sh (MC_SECRETS_FILE). Copy it OUTSIDE the
# repository (or to a name ending in .secrets.env, which git ignores) and fill it in.
# Supabase sets SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY and SUPABASE_DB_URL by itself.

# The server's database connection: the transaction pooler (port 6543), user postgres.<ref>
# (the owner that applied db/migrations; keeps its access after session C's lock-down).
MC_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# The direct storage host, for large TUS uploads.
MC_STORAGE_URL=https://<ref>.storage.supabase.co
# The publishable (anon) key. Public: sent to clients with their TUS requests.
MC_PUBLISHABLE_KEY=<publishable key>
# Only if the project still signs tokens with the legacy HS256 secret.
# MC_LEGACY_JWT_SECRET=<legacy JWT secret>
# The project's file size limit, as in your shell for the stand-up: 50MiB on the free Phase 0
# project, 5GiB on Pro. Uploads above it are refused in plain words.
MC_FILE_SIZE_LIMIT=50MiB
# Life of a signed playback or cover link, in seconds.
MC_READ_TTL_SECONDS=600
# Jobs.enqueue starts a Fly machine per job.
FLY_API_TOKEN=<Fly token that may create machines in the worker app>
MC_FLY_APP=<worker app name>
MC_FLY_WORKER_IMAGE=registry.fly.io/<worker app name>:phase0
MC_FLY_REGION=iad
# Email through Resend (free plan; a verified sending domain is needed).
RESEND_API_KEY=<Resend API key>
MC_EMAIL_FROM=Milk Crate <noreply@<verified domain>>

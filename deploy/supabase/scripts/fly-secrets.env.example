# The worker's Fly secrets for scripts/stand-up.sh (MC_FLY_SECRETS_FILE). Copy it OUTSIDE the
# repository (or to a name ending in .secrets.env) and fill it in.
# The session pooler (port 5432) or the direct connection, user postgres (the owner).
MC_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<secret key>
# Optional: how long one job may run before it is stopped and reported as failed (default 240).
# MC_JOB_TIME_LIMIT_MINUTES=240

{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Milk Crate Phase 0: lets the aws-sandbox GitHub workflow sign in to this AWS account without stored keys (GitHub OIDC). Deploy once by hand; see deploy/aws/README.md.",
  "Parameters": {
    "CreateOidcProvider": {
      "Type": "String",
      "AllowedValues": ["true", "false"],
      "Default": "true",
      "Description": "false if this account already has an IAM identity provider for token.actions.githubusercontent.com."
    }
  },
  "Conditions": {
    "MakeProvider": { "Fn::Equals": [{ "Ref": "CreateOidcProvider" }, "true"] }
  },
  "Resources": {
    "GitHubProvider": {
      "Type": "AWS::IAM::OIDCProvider",
      "Condition": "MakeProvider",
      "Properties": {
        "Url": "https://token.actions.githubusercontent.com",
        "ClientIdList": ["sts.amazonaws.com"],
        "ThumbprintList": ["6938fd4d98bab03faadb97b34396831e3780aea1"]
      }
    },
    "SandboxRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "MilkCrateSandboxDeploy",
        "Description": "Assumed only by The-Milk-Crate/Milk-Crate's aws-sandbox environment, after K Marcus approves the run.",
        "MaxSessionDuration": 10800,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:oidc-provider/token.actions.githubusercontent.com"
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": "repo:The-Milk-Crate/Milk-Crate:environment:aws-sandbox"
                }
              }
            }
          ]
        },
        "ManagedPolicyArns": [{ "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/PowerUserAccess" }],
        "Policies": [
          {
            "PolicyName": "pass-worker-roles",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "SmokeTestStartsTheWorkerTask",
                  "Effect": "Allow",
                  "Action": "iam:PassRole",
                  "Resource": { "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/MilkCratePhase0-*" },
                  "Condition": { "StringEquals": { "iam:PassedToService": "ecs-tasks.amazonaws.com" } }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "RoleArn": {
      "Description": "Set this as the AWS_ROLE_ARN variable of the aws-sandbox GitHub environment.",
      "Value": { "Fn::GetAtt": ["SandboxRole", "Arn"] }
    }
  }
}

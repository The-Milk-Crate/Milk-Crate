{
  "name": "@milk-crate/deploy-aws",
  "private": true,
  "version": "0.0.0",
  "description": "Phase 0: the platform modules on AWS, the Fargate worker skeleton, the CDK definition and the stand-up scripts.",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "test": "bash test/run.sh",
    "synth": "cdk synth --quiet"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1160.0",
    "@aws-sdk/client-ecs": "3.1160.0",
    "@aws-sdk/client-rds-data": "3.1160.0",
    "@aws-sdk/client-s3": "3.1160.0",
    "@aws-sdk/client-scheduler": "3.1160.0",
    "@aws-sdk/client-secrets-manager": "3.1160.0",
    "@aws-sdk/client-sesv2": "3.1160.0",
    "@aws-sdk/client-sqs": "3.1160.0",
    "@aws-sdk/client-cloudfront": "3.1160.0",
    "@aws-sdk/cloudfront-signer": "3.1157.0",
    "@aws-sdk/s3-request-presigner": "3.1160.0",
    "jose": "6.2.3"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/pg": "8.15.6",
    "aws-cdk": "2.1146.1",
    "aws-cdk-lib": "2.275.0",
    "constructs": "10.8.1",
    "esbuild": "0.28.2",
    "pg": "8.23.1",
    "typescript": "5.9.3"
  }
}

# Settings for the AWS stand-up (MC_SETTINGS_FILE). Copy it OUTSIDE the repository and fill it
# in. No secrets go here: AWS credentials come from your AWS CLI profile (AWS_PROFILE), and the
# CloudFront private key stays in its own file, which the stand-up copies into Secrets Manager.

# The AWS account and region to stand up in. The stand-up asks you to type both again.
MC_AWS_ACCOUNT=123456789012
MC_AWS_REGION=eu-west-2
# The CloudFormation stack name.
MC_STACK_NAME=MilkCratePhase0
# The domain SES sends from (you add its DKIM records to DNS), and the From address on it.
MC_EMAIL_DOMAIN=<your domain>
MC_EMAIL_FROM=Milk Crate <noreply@<your domain>>
# The CloudFront key pair for signed cookies, made once with:
#   openssl genrsa -out cloudfront-private.pem 2048
#   openssl rsa -pubout -in cloudfront-private.pem -out cloudfront-public.pem
# Keep both files outside the repository.
MC_CLOUDFRONT_PUBLIC_KEY_FILE=/path/outside/the/repository/cloudfront-public.pem
MC_CLOUDFRONT_PRIVATE_KEY_FILE=/path/outside/the/repository/cloudfront-private.pem
# Where the stand-up writes the stack's outputs (not secret, but per deployment).
MC_OUTPUTS_FILE=/path/outside/the/repository/milk-crate-aws-outputs.json
# Origins allowed to PUT upload parts to S3 (comma-separated). Default "*": the presigned URL
# is the permission.
# MC_UPLOAD_ORIGINS=tauri://localhost,http://tauri.localhost

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Recording records: a turntable (USB or line in) is an audio input. With macOS's hardened
       runtime, an app without this gets silence from every input and is never even asked. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>

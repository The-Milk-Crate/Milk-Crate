{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Milk Crate",
  "version": "0.1.0",
  "identifier": "org.milkcrate.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Milk Crate",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob: https://dpnkngadsewzrkedlwmi.supabase.co; media-src 'self' asset: http://asset.localhost blob: https://dpnkngadsewzrkedlwmi.supabase.co; style-src 'self' 'unsafe-inline'; font-src 'self' data: asset: http://asset.localhost blob: https://dpnkngadsewzrkedlwmi.supabase.co; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost blob: https://dpnkngadsewzrkedlwmi.supabase.co wss://dpnkngadsewzrkedlwmi.supabase.co https://api.pwnedpasswords.com",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5MUY2RUNCQ0M1MTlCMkIKUldRcm0xSE15MjRmNmFuWjZwR3hNSk5Zc09OT09uSzh0T3R3NlBWc3c4WGlQcU1SMU5MUnBPWUsK",
      "endpoints": [
        "https://github.com/The-Milk-Crate/Milk-Crate/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "milkcrate"
        ]
      }
    }
  }
}

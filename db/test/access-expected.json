  "invitation": {
    "about": "getInvitation and respondToSplit. The invitee has no rights to the release rows; only the invite code lets them in. The caller is not the owner, and no staff account may use it.",
    "callers": {
      "end_user": "allowed",
      "artist": "allowed",
      "third_party": "allowed",
      "administrator": 403,
      "internal": 403,
      "internal_accounting": 403
    },
    "cases": {
      "valid": {
        "status": "ok",
        "getInvitation": 200,
        "respondToSplit": 200
      },
      "wrong_code": {
        "status": "wrong_code",
        "getInvitation": 403,
        "respondToSplit": 403
      },
      "expired": {
        "status": "expired",
        "getInvitation": 403,
        "respondToSplit": 403
      },
      "replied": {
        "status": "replied",
        "getInvitation": 409,
        "respondToSplit": 409
      },
      "taken_down": {
        "status": "taken_down",
        "getInvitation": 409,
        "respondToSplit": 409
      },
      "rate_limited": {
        "status": "rate_limited",
        "getInvitation": 429,
        "respondToSplit": 429
      },
      "not_found": {
        "status": "not_found",
        "getInvitation": 404,
        "respondToSplit": 404
      }
    },
    "invitationFields": ["releaseTitle", "artistName", "releaseDate", "trackTitles", "party.side", "party.role", "party.percent", "party.state"],
    "neverIncluded": ["owner_id", "other parties", "any email", "the invite code or its hash", "review details", "keys"],
    "onlyOkHasFields": true,
    "respondLinks": "the signed-in account, never an account named by the caller",
    "inviteeDirectReads": "An invitee reads nothing of the release beyond the Invitation fields: the release, tracks, rights and uploads stay hidden unless the release is live, and then only through the public view."
  },
  "supabaseOnly": {
    "about": "Direct table access on Supabase (PostgREST). Not for the handlers. anon reaches nothing. Clients only read; every write goes through the server.",
    "readsLike": {
      "api_releases": "getRelease 200",
      "api_tracks": "getRelease 200 (columns id, release_id, position, title, master_confirmed_at, created_at, updated_at)",
      "api_parties": "getRelease 200 (no invite code hash, invite times or responder)",
      "api_covers": "getRelease 200 (columns release_id, confirmed_at)",
      "api_uploads": "getUpload 200 (no provider_upload_id or checksums)",
      "api_public_releases": "getPublicRelease 200",
      "api_public_tracks": "getPublicRelease 200",
      "api_can_play_track(track)": "getPlayback 200",
      "api_can_read_cover(release)": "getCover 200",
      "api_client_get_invitation(release, party, code)": "getInvitation",
      "api_client_respond_to_invite(release, party, code, response)": "respondToSplit"
    },
    "neverReadable": ["api_accounts", "api_review_decisions", "api_invite_sends", "api_invite_wrong_codes", "api_jobs", "api_play_batches", "api_play_events", "api_qualified_streams", "api_audit_log"]
  }
